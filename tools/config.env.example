# =============================================================================
# 配置模板 —— 复制成 config.env 后填自己的路径
#
#     cp tools/config.env.example tools/config.env
#
# ★ 本文件**不含任何私有信息**：主机名、账号、密码、个人目录一律不写死。
#   所有脚本通过 `source tools/config.env` 取值 ⇒ 换机器只需改这一个文件。
# ★ 真正的 config.env 已被 .gitignore 忽略，**不要提交**（否则会把自己的路径/凭据推上去）。
# =============================================================================

# ---- Python 环境（需含 torch + transformers + scikit-learn）----
VENV=/path/to/venv

# ---- 模型权重缓存目录 ----
HF_CACHE=/path/to/hf_cache
# 各编码器的本地目录。下载后用 `ls` 确认里面有 config.json 与权重文件：
#   单文件格式 → model.safetensors
#   分片格式   → model-0000X-of-0000Y.safetensors + model.safetensors.index.json（6B 是 6 片）
ESMC_300M=$HF_CACHE/ESMC-300M
ESMC_600M=$HF_CACHE/ESMC-600M
ESMC_6B=$HF_CACHE/ESMC-6B

# ---- 下载 ----
# HF 主站在部分网络不稳时改用镜像；该镜像会间歇性返回 200 但 body 0 字节，
# 所以下载器必须带 --speed-limit/--speed-time（见 ddg/download_data.sh）。
HF_ENDPOINT=https://hf-mirror.com

# ---- 资源 ----
GPU=0                 # 绑到哪张卡（CUDA_VISIBLE_DEVICES）
THREADS=32            # BLAST / OMP 线程数

# ---- 批大小 ----
# 批大小**不影响结论**，只影响速度与显存，按自己的卡调即可。
BATCH_300M=32
BATCH_600M=32
BATCH_6B=8            # 2560 维 / 80 层的 6B 用大了会白吃显存
